# ============================================================================
# AidOps AI - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# Demo mode works with defaults (no API keys required)
# ============================================================================

# Application Settings
# ----------------------------------------------------------------------------
APP_NAME=AidOps AI
APP_VERSION=1.0.0
ENVIRONMENT=development  # development | production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# Server Configuration
# ----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# CORS Settings
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# Database (SQLite for metadata)
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./aidops.db
# For production: postgresql://user:password@localhost:5432/aidops

# Redis Configuration
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600  # seconds

# LLM Provider Settings
# ----------------------------------------------------------------------------
# Leave empty for demo mode (uses mock LLM)
LLM_PROVIDER=openai  # openai | anthropic | mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4-turbo-preview  # or claude-3-opus-20240229
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# LiteLLM Gateway (optional)
# ----------------------------------------------------------------------------
USE_LITELLM=false
LITELLM_API_BASE=

# Embedding Provider
# ----------------------------------------------------------------------------
# Leave empty for demo mode (uses local sentence-transformers)
EMBEDDING_PROVIDER=openai  # openai | local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector Database
# ----------------------------------------------------------------------------
# Leave empty for demo mode (uses local FAISS)
VECTOR_DB_PROVIDER=faiss  # pinecone | faiss | chroma
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=aidops-ai
VECTOR_DB_DIMENSION=1536  # Match embedding model dimension

# Audio Transcription
# ----------------------------------------------------------------------------
# Leave empty for demo mode (uses local faster-whisper)
TRANSCRIPTION_PROVIDER=local  # openai | local
WHISPER_MODEL=base  # tiny | base | small | medium | large

# External Feeds (for crisis monitoring)
# ----------------------------------------------------------------------------
# Leave empty for demo mode (uses mock feeds)
NEWS_API_KEY=
WEATHER_API_KEY=
FEED_POLL_INTERVAL=300  # seconds

# RAG Configuration
# ----------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.7
USE_HYBRID_SEARCH=true
USE_RERANKING=false

# Security & Rate Limiting
# ----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-change-this-in-production
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,mp3,wav,csv,xlsx

# Observability
# ----------------------------------------------------------------------------
ENABLE_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aidops-ai
ENABLE_TOKEN_TRACKING=true

# File Storage
# ----------------------------------------------------------------------------
UPLOAD_DIR=./uploads
SAMPLE_DATA_DIR=./data/sample

# Agent Workflows
# ----------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120

# Demo Mode Flag
# ----------------------------------------------------------------------------
# Set to true to force demo mode regardless of API keys
FORCE_DEMO_MODE=false
